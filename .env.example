# =====================================================================
# COMPLY-MA — Configuration production
# Copier en .env et REMPLIR les valeurs obligatoires avant démarrage.
# =====================================================================

# ── OBLIGATOIRE ──────────────────────────────────────────────────────
# Environnement : "dev" ou "production".
# En production, l'application REFUSE de démarrer si SECRET_KEY est
# la valeur par défaut, ou si DEBUG=true.
COMPLY_MA_ENVIRONMENT=production

# Clé secrète des sessions — générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
COMPLY_MA_SECRET_KEY=

# ── Application ──────────────────────────────────────────────────────
COMPLY_MA_DEBUG=false
COMPLY_MA_DATABASE_URL=sqlite:///./data/cabinets/metadata.db
COMPLY_MA_CABINET_MODE=true
COMPLY_MA_HTTPS_ONLY=true

# ── Logging ──────────────────────────────────────────────────────────
COMPLY_MA_LOG_LEVEL=info
COMPLY_MA_LOG_FORMAT=json

# ── Legal ────────────────────────────────────────────────────────────
COMPLY_MA_RETENTION_YEARS=10

# ── Signature XML (production : certificat PKCS#12 requis) ──────────
# Sans ce chemin, un certificat auto-signé de dev est utilisé (avertissement).
COMPLY_MA_PKCS12_CERT_PATH=
COMPLY_MA_PKCS12_PASSPHRASE=

# ── Clearance DGI ────────────────────────────────────────────────────
# "mock" = dev/test uniquement (factures marquées cleared sans DGI —
# avertissement au démarrage). "dgi" = API réelle (quand publiée).
COMPLY_MA_CLEARANCE_PROVIDER=mock
COMPLY_MA_DGI_API_BASE_URL=
COMPLY_MA_DGI_API_KEY=
COMPLY_MA_DGI_TOKEN_URL=
COMPLY_MA_DGI_CLIENT_ID=
COMPLY_MA_DGI_CLIENT_SECRET=
COMPLY_MA_XML_FORMAT=ubl

# ── SMTP (envoi de factures par email) ──────────────────────────────
COMPLY_MA_SMTP_HOST=
COMPLY_MA_SMTP_PORT=587
COMPLY_MA_SMTP_USER=
COMPLY_MA_SMTP_PASSWORD=
COMPLY_MA_SMTP_FROM=
COMPLY_MA_SMTP_TLS=true

# ── WhatsApp Cloud API (optionnel) ───────────────────────────────────
COMPLY_MA_WHATSAPP_API_TOKEN=
COMPLY_MA_WHATSAPP_PHONE_NUMBER_ID=
COMPLY_MA_WHATSAPP_VERIFY_TOKEN=change-this-verify-token
COMPLY_MA_WHATSAPP_APP_SECRET=
